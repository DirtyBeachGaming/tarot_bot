# Copy this file to .env and fill it in. Never commit .env.

# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# Right-click your server icon → Copy Server ID (needs Developer Mode on)
GUILD_ID=

# Right-click the tarot channel → Copy Channel ID. The bot only answers here
# (and in threads inside it).
TAROT_CHANNEL_ID=

# Chance each card lands reversed: 0 = never, 0.5 = half the time
REVERSAL_CHANCE=0.3

# Readings (/draw or /reading) each member gets per rolling 24 hours. 0 = unlimited.
# /card lookups are always free. Admins (Manage Server) are exempt unless set to false.
DAILY_LIMIT=1
LIMIT_EXEMPT_ADMINS=true

# Where the limit database lives. On Railway, attach a Volume mounted at /data
# and set STATE_DIR=/data so limits survive redeploys.
STATE_DIR=state
